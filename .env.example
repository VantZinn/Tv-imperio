PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Crie uma chave gratuita no Google AI Studio. Mantenha o projeto no Free tier.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=https://appassets.androidplatform.net,http://localhost:8080,http://127.0.0.1:8080
# 0 remove os limites diários internos de análises. As cotas do Google continuam válidas.
AI_GLOBAL_DAILY_LIMIT=0
AI_USER_DAILY_LIMIT=0
# A geração automática mantém uma parcela separada; 0 aqui desativa somente os lotes automáticos.
AI_BACKGROUND_DAILY_LIMIT=4
AI_TIMEOUT_MS=60000
SOCIAL_INTERVAL_MINUTES=360
WORLD_INTERVAL_MINUTES=720
REGISTRATION_ENABLED=true
# OpenAI só é usada se você configurar AI_PROVIDER=openai explicitamente.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
